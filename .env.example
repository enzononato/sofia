# Application
APP_NAME="Clinic SaaS"
DEBUG=false
SECRET_KEY="CHANGE-ME-use-openssl-rand-hex-32"

# Database (use asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/clinic_saas"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Tenant resolution strategy: header | subdomain | jwt
TENANT_RESOLUTION_STRATEGY=header
TENANT_HEADER_NAME=X-Tenant-ID

# CORS
ALLOWED_ORIGINS='["http://localhost:3000"]'

# AI / Gemini (global key; model/behavior fixed in code)
GEMINI_API_KEY=AIza...
DEFAULT_AI_MODEL=gemini-2.5-flash
AI_HISTORY_LIMIT=20

# UAZAPI (server URL + admin token; per-instance token stored in tenant.settings.whatsapp)
UAZAPI_URL=https://sua-instancia.uazapi.com
UAZAPI_ADMIN_TOKEN=seu-admin-token

# Error alerting by email (opt-in). When ALERT_EMAIL_ENABLED=true and SMTP is
# set, any ERROR-level log emails the team (off-thread, throttled). Leave
# disabled to keep errors going only to the JSON logs.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=seu-email@gmail.com
ALERT_SMTP_PASSWORD=sua-senha-de-app
ALERT_SMTP_USE_TLS=true
ALERT_SMTP_USE_SSL=false
ALERT_EMAIL_FROM="Sofia Alertas <seu-email@gmail.com>"
ALERT_EMAIL_TO=voce@clinica.com
ALERT_MIN_INTERVAL_SECONDS=300

# Human-handoff alert job (app/services/followups.py::run_paused_alert). Emails
# the clinic (tenant.email) when a contact stays ai_paused with an unanswered
# inbound message for HANDOFF_ALERT_STALE_MINUTES; only once per pause episode.
# Per-tenant opt-out: tenant.settings.followups.handoff_alert_email_enabled.
HANDOFF_ALERT_JOB_MINUTES=10
HANDOFF_ALERT_STALE_MINUTES=30

# Logging. LOG_FORMAT=text -> logs visuais legíveis (ícones + rótulos em pt-BR,
# ideal para ler no console do EasyPanel). LOG_FORMAT=json -> uma linha JSON por
# evento, para agregadores (Datadog/Loki). LOG_LEVEL: DEBUG|INFO|WARNING|ERROR.
LOG_LEVEL=INFO
LOG_FORMAT=text
