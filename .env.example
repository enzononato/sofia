# Application
APP_NAME="Clinic SaaS"
DEBUG=false
SECRET_KEY="CHANGE-ME-use-openssl-rand-hex-32"

# Database (use asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/clinic_saas"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Tenant resolution strategy: header | subdomain | jwt
TENANT_RESOLUTION_STRATEGY=header
TENANT_HEADER_NAME=X-Tenant-ID

# CORS
ALLOWED_ORIGINS='["http://localhost:3000"]'

# AI / Gemini (global fallback — per-tenant key stored in tenants.ai_config)
GEMINI_API_KEY=AIza...
DEFAULT_AI_MODEL=gemini-2.0-flash
AI_HISTORY_LIMIT=20

# UAZAPI (server URL + admin token; per-instance token stored in tenant.settings.whatsapp)
UAZAPI_URL=https://sua-instancia.uazapi.com
UAZAPI_ADMIN_TOKEN=seu-admin-token
